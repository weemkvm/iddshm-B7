;
; IDDShm.inf
;

[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=IDDShm.cat
DriverVer=0.1
PnpLockDown=1

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%DeviceName%=IDDShm_Install, Root\IDDShm
%DeviceName%=IDDShm_Install, IDDShm

[SourceDisksFiles]
IDDShm.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[IDDShm_Install.NT]
CopyFiles=UMDriverCopy

[IDDShm_Install.NT.hw]
AddReg = IDDShm_HardwareDeviceSettings

[IDDShm_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "IDDShmGroup"

[IDDShm_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[IDDShm_Install.NT.Wdf]
UmdfService=IDDShm,IDDShm_Install
UmdfServiceOrder=IDDShm
UmdfKernelModeClientPolicy=AllowKernelModeClients

[IDDShm_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\IDDShm.dll
UmdfExtensions=IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=12, UMDF ; copy to drivers\umdf

[UMDriverCopy]
IDDShm.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Microsoft"
DiskName = "IDDShm Installation Disk"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="IDD Cx Shared Memory Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001
