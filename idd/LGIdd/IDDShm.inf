;
; ElgDisp.inf
;

[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=ElgDisp.cat
DriverVer=0.1
PnpLockDown=1

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%DeviceName%=ElgDisp_Install, Root\ElgDisp
%DeviceName%=ElgDisp_Install, ElgDisp

[SourceDisksFiles]
ElgDisp.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[ElgDisp_Install.NT]
CopyFiles=UMDriverCopy

[ElgDisp_Install.NT.hw]
AddReg = ElgDisp_HardwareDeviceSettings

[ElgDisp_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "ElgDispGrp"

[ElgDisp_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[ElgDisp_Install.NT.Wdf]
UmdfService=ElgDisp,ElgDisp_Install
UmdfServiceOrder=ElgDisp
UmdfKernelModeClientPolicy=AllowKernelModeClients

[ElgDisp_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\ElgDisp.dll
UmdfExtensions=IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=12, UMDF ; copy to drivers\umdf

[UMDriverCopy]
ElgDisp.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Elgato Systems GmbH"
DiskName = "Elgato Display Driver Installation Disk"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="Elgato Virtual Display Adapter"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001
